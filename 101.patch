+  ].join('\u0000')
+}
+
+function mergePaymentMetadata(extractDocuments, paymentDocuments) {
+  const paymentsByKey = new Map()
+  for (const payment of paymentDocuments) {
+    const key = documentMatchKey(payment)
+    const bucket = paymentsByKey.get(key) ?? []
+    bucket.push(payment)
+    paymentsByKey.set(key, bucket)
+  }
+
+  return extractDocuments.map((document) => {
+    const bucket = paymentsByKey.get(documentMatchKey(document))
+    const payment = bucket?.shift()
+    if (!payment) return document
+    return {
+      ...document,
+      DayDate: pick(document, 'DayDate') || pick(payment, 'DayDate'),
+      Created: pick(document, 'Created') || pick(payment, 'Created'),
+      Changed: pick(document, 'Changed') || pick(payment, 'Changed'),
+      PaymentType: pick(document, 'PaymentType') || pick(payment, 'PaymentType'),
+    }
+  })
+}
+
+function documentTimestamp(document) {
+  const value = pick(document, 'Created', 'Changed')
+  const match = /^(\d{2})\.(\d{2})\.(\d{4})\s+(\d{2}):(\d{2})(?::(\d{2}))?$/.exec(value)
+  if (!match) return Number.NaN
+  return Date.UTC(
+    Number(match[3]),
+    Number(match[2]) - 1,
+    Number(match[1]),
+    Number(match[4]),
+    Number(match[5]),
+    Number(match[6] ?? 0),
+  )
+}
+
+function documentDelta(document, accountIban) {
+  const amount = optionalNumber(pick(document, 'Amount', 'CrncyCredit', 'CreditAmount', 'Credit', 'SumCredit'))
+  if (amount === null) return null
+
+  const creditIban = normalizeIban(pick(document, 'CreditCodeIBAN', 'CreditIBAN', 'creditIBAN'))
+  const debitIban = normalizeIban(pick(document, 'DebitCodeIBAN', 'DebitIBAN', 'debitIBAN'))
+  if (creditIban === accountIban) return amount
+  if (debitIban === accountIban) return -amount
+
+  const paymentType = pick(document, 'PaymentType').toUpperCase()
+  if (paymentType === 'CREDIT') return amount
+  if (paymentType === 'DEBIT') return -amount
+  return null
+}
+
+function calculateRunningBalances(documents, accountIban) {
+  const groups = new Map()
+  for (const document of documents) {
+    const day = pick(document, 'StatementDate', 'DayDate', 'OrgDate')
+    const bucket = groups.get(day) ?? []
+    bucket.push(document)
+    groups.set(day, bucket)
+  }
+
+  const calculated = []
+  for (const group of groups.values()) {
+    const ordered = [...group].sort((left, right) => {
+      const leftTime = documentTimestamp(left)
+      const rightTime = documentTimestamp(right)
+      if (Number.isFinite(leftTime) && Number.isFinite(rightTime) && leftTime !== rightTime) {
+        return leftTime - rightTime
+      }
+      return Number(pick(left, 'StatementSequence') || 0) - Number(pick(right, 'StatementSequence') || 0)
+    })
+
+    let balance = optionalNumber(pick(ordered[0], 'StatementInCome'))
+    for (const document of ordered) {
+      const delta = documentDelta(document, accountIban)
+      if (balance !== null && delta !== null) balance += delta
+      calculated.push({
+        ...document,
+        CalculatedBalance: balance,
+      })
+    }
+  }
+  return calculated
+}
