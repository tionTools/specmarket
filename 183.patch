+private fun openDialer(context: Context, phone: String) {
+    val value = normalizeCustomerPhone(phone)
+    if (value == null) {
+        Toast.makeText(context, "Некорректный номер телефона.", Toast.LENGTH_SHORT).show()
+        return
+    }
+    context.startActivity(Intent(Intent.ACTION_DIAL, Uri.fromParts("tel", value, null)))
+}
+
+private fun launchExternal(context: Context, uri: Uri): Boolean = try {
+    context.startActivity(Intent(Intent.ACTION_VIEW, uri))
+    true
+} catch (_: Exception) {
+    false
+}
+
+private fun copyReminderAndOpenChat(context: Context, phone: String, channel: String, message: String): Boolean {
+    val normalized = normalizeCustomerPhone(phone) ?: return false
+    val clipboard = context.getSystemService(Context.CLIPBOARD_SERVICE) as android.content.ClipboardManager
+    clipboard.setPrimaryClip(ClipData.newPlainText("Нагадування", message))
+    val opened = if (channel == "viber") {
+        val uri = Uri.Builder().scheme("viber").authority("chat")
+            .appendQueryParameter("number", normalized).build()
+        launchExternal(context, uri)
+    } else {
+        // Text stays on the clipboard: tg://resolve cannot guarantee a specific private
+        // chat will accept an attached prefilled draft.
+        val uri = Uri.Builder().scheme("tg").authority("resolve")
+            .appendQueryParameter("phone", normalized).build()
+        launchExternal(context, uri)
+    }
+    Toast.makeText(context,
+        if (opened) "Текст скопирован. Вставьте его в чат и отправьте."
+        else "Текст скопирован. Откройте нужный чат вручную.",
+        Toast.LENGTH_LONG).show()
+    return opened
+}
+
+private fun openViber(context: Context, phone: String) {
+    val value = normalizeCustomerPhone(phone) ?: return
+    val uri = Uri.Builder()
+        .scheme("viber")
+        .authority("chat")
+        .appendQueryParameter("number", value)
+        .build()
+    if (!launchExternal(context, uri)) {
+        Toast.makeText(context, "Viber не установлен или не открыл чат.", Toast.LENGTH_SHORT).show()
+    }
+}
+
+private fun openTelegram(context: Context, phone: String) {
+    val value = normalizeCustomerPhone(phone) ?: return
+    val uri = Uri.Builder()
+        .scheme("tg")
+        .authority("resolve")
+        .appendQueryParameter("phone", value)
+        .build()
+    if (!launchExternal(context, uri) && !launchExternal(context, Uri.parse("https://t.me/$value"))) {
+        Toast.makeText(context, "Telegram не установлен или номер недоступен.", Toast.LENGTH_SHORT).show()
+    }
+}
