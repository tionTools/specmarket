new file mode 100644
--- /dev/null
+++ b/supabase/functions/_shared/novapay-running-balance.ts
@@ -0,0 +1,154 @@
+function text(value) {
+  return typeof value === 'string' ? value.trim() : ''
+}
+
+function moneyCents(value) {
+  if (value === null || value === undefined) return null
+  if (typeof value === 'string' && value.trim() === '') return null
+  const number = Number(value)
+  return Number.isFinite(number) ? Math.round(number * 100) : null
+}
+
+function aliases(receipt) {
+  if (!Array.isArray(receipt?.providerAliases)) return []
+  return [...new Set(receipt.providerAliases.map(text).filter(Boolean))]
+}
+
+function summaryCents(summary) {
+  if (!summary) return null
+  const opening = moneyCents(summary.opening)
+  const debitTotal = moneyCents(summary.debitTotal)
+  const creditTotal = moneyCents(summary.creditTotal)
+  const closing = moneyCents(summary.closing)
+  if (
+    opening === null ||
+    debitTotal === null ||
+    creditTotal === null ||
+    closing === null ||
+    debitTotal < 0 ||
+    creditTotal < 0
+  )
+    return null
+  if (opening + creditTotal - debitTotal !== closing) return null
+  return { opening, debitTotal, creditTotal, closing }
+}
+
+export function assignBalancesFromAllMovements(receipts, movements, daySummaries) {
+  const result = receipts.map((receipt) => ({ ...receipt }))
+  const movementsByDate = new Map()
+  const invalidDates = new Set()
+  let hasUndatedInvalidMovement = false
+
+  for (const movement of movements) {
+    const date = text(movement?.legacyDate)
+    if (!date) {
+      hasUndatedInvalidMovement = true
+      continue
+    }
+
+    const amountCents = moneyCents(movement?.amount)
+    const createdTimestamp = Date.parse(text(movement?.createdAt))
+    const changedTimestamp = Date.parse(text(movement?.changedAt))
+    const direction = movement?.direction
+    if (
+      amountCents === null ||
+      amountCents <= 0 ||
+      !Number.isFinite(createdTimestamp) ||
+      !Number.isFinite(changedTimestamp) ||
+      (direction !== 'credit' && direction !== 'debit')
+    ) {
+      invalidDates.add(date)
+      continue
+    }
+
+    movementsByDate.set(date, [
+      ...(movementsByDate.get(date) ?? []),
+      { movement, amountCents, createdTimestamp, changedTimestamp, direction },
+    ])
+  }
+
+  if (hasUndatedInvalidMovement) return result
+
+  const balanceByAlias = new Map()
+  for (const [date, dayMovements] of movementsByDate) {
+    if (invalidDates.has(date)) continue
+
+    const summary = summaryCents(daySummaries.get(date))
+    if (!summary) continue
+
+    let movementDebitCents = 0
+    let movementCreditCents = 0
+    for (const entry of dayMovements) {
+      if (entry.direction === 'credit') movementCreditCents += entry.amountCents
+      else movementDebitCents += entry.amountCents
+    }
+
+    if (
+      movementDebitCents !== summary.debitTotal ||
+      movementCreditCents !== summary.creditTotal
+    )
+      continue
+
+    const byChanged = [...dayMovements].sort(
+      (left, right) => right.changedTimestamp - left.changedTimestamp,
+    )
+    const byCreated = [...dayMovements].sort(
+      (left, right) => right.createdTimestamp - left.createdTimestamp,
+    )
+    const duplicateChanged = byChanged.some(
+      (entry, index) =>
+        index > 0 && entry.changedTimestamp === byChanged[index - 1].changedTimestamp,
+    )
+    const duplicateCreated = byCreated.some(
+      (entry, index) =>
+        index > 0 && entry.createdTimestamp === byCreated[index - 1].createdTimestamp,
+    )
+    const orderDisagrees =
+      byChanged.length !== byCreated.length ||
+      byChanged.some((entry, index) => entry !== byCreated[index])
+    if (duplicateChanged || duplicateCreated || orderDisagrees) continue
+
+    let balanceAfterCents = summary.closing
+    const dayAliases = []
+    for (const entry of byChanged) {
+      if (entry.direction === 'credit') {
+        for (const alias of aliases(entry.movement)) {
+          balanceByAlias.set(alias, balanceAfterCents / 100)
+          dayAliases.push(alias)
+        }
+        balanceAfterCents -= entry.amountCents
+      } else {
+        balanceAfterCents += entry.amountCents
+      }
+    }
+
+    if (balanceAfterCents !== summary.opening) {
+      for (const alias of dayAliases) balanceByAlias.delete(alias)
+    }
+  }
+
+  return result.map((receipt) => {
+    for (const alias of aliases(receipt)) {
+      if (balanceByAlias.has(alias)) {
+        return { ...receipt, balance: balanceByAlias.get(alias) }
+      }
+    }
+    return receipt
+  })
+}
+
+export function copyKnownBalancesByProviderAlias(receipts, statementReceipts) {
+  const balanceByAlias = new Map()
+  for (const receipt of statementReceipts) {
+    const balance = receipt?.balance
+    if (typeof balance !== 'number' || !Number.isFinite(balance)) continue
+    for (const alias of aliases(receipt)) balanceByAlias.set(alias, balance)
+  }
+
+  return receipts.map((receipt) => {
+    for (const alias of aliases(receipt)) {
+      if (balanceByAlias.has(alias)) return { ...receipt, balance: balanceByAlias.get(alias) }
+    }
+    return receipt
+  })
+}
diff --git a/supabase/functions/_shared/novapay-running-balance_test.ts b/supabase/functions/_shared/novapay-running-balance_test.ts
