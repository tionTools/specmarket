--- /dev/null
+++ b/supabase/functions/_shared/novapay-running-balance_test.ts
@@ -0,0 +1,202 @@
+import {
+  assignBalancesFromAllMovements,
+  copyKnownBalancesByProviderAlias,
+} from './novapay-running-balance.ts'
+
+function assertEquals(actual, expected, message) {
+  if (actual !== expected) throw new Error(`${message}: ${actual} !== ${expected}`)
+}
+
+function movement(receipt, direction, createdAt = receipt.occurredAt, changedAt = receipt.occurredAt) {
+  return { ...receipt, direction, createdAt, changedAt }
+}
+
+const productionSummaries = new Map([
+  [
+    '18.09.2026',
+    { opening: 5999.49, debitTotal: 0, creditTotal: 1248.72, closing: 7248.21 },
+  ],
+  [
+    '19.09.2026',
+    { opening: 7248.21, debitTotal: 0, creditTotal: 752.22, closing: 8000.43 },
+  ],
+])
+const productionReceipts = [
+  {
+    legacyDate: '19.09.2026',
+    occurredAt: '2026-09-19T16:47:04.000Z',
+    amount: 626.85,
+    balance: null,
+    providerAliases: ['id:later'],
+  },
+  {
+    legacyDate: '19.09.2026',
+    occurredAt: '2026-09-19T10:56:25.000Z',
+    amount: 125.37,
+    balance: null,
+    providerAliases: ['id:earlier'],
+  },
+  {
+    legacyDate: '18.09.2026',
+    occurredAt: '2026-09-18T16:55:54.000Z',
+    amount: 1248.72,
+    balance: null,
+    providerAliases: ['id:previous-day'],
+  },
+]
+const productionMovements = productionReceipts.map((receipt) => movement(receipt, 'credit'))
+const productionResult = assignBalancesFromAllMovements(
+  productionReceipts,
+  productionMovements,
+  productionSummaries,
+)
+assertEquals(productionResult[0].balance, 8000.43, 'latest 19.09 credit gets day close')
+assertEquals(productionResult[1].balance, 7373.58, 'earlier 19.09 credit gets running balance')
+assertEquals(productionResult[2].balance, 7248.21, 'single 18.09 credit keeps day close')
+
+const debitSummaries = new Map([
+  ['20.09.2026', { opening: 1000, debitTotal: 50, creditTotal: 300, closing: 1250 }],
+])
+const debitReceipts = [
+  {
+    legacyDate: '20.09.2026',
+    occurredAt: '2026-09-20T09:00:00.000Z',
+    amount: 200,
+    balance: null,
+    providerAliases: ['id:credit-2'],
+  },
+  {
+    legacyDate: '20.09.2026',
+    occurredAt: '2026-09-20T07:00:00.000Z',
+    amount: 100,
+    balance: null,
+    providerAliases: ['id:credit-1'],
+  },
+]
+const debitMovements = [
+  movement(debitReceipts[0], 'credit'),
+  {
+    legacyDate: '20.09.2026',
+    createdAt: '2026-09-20T08:00:00.000Z',
+    changedAt: '2026-09-20T08:00:00.000Z',
+    amount: 50,
+    providerAliases: ['id:debit-1'],
+    direction: 'debit',
+  },
+  movement(debitReceipts[1], 'credit'),
+]
+const debitResult = assignBalancesFromAllMovements(debitReceipts, debitMovements, debitSummaries)
+assertEquals(debitResult[0].balance, 1250, 'later credit balance after intervening debit')
+assertEquals(debitResult[1].balance, 1100, 'earlier credit restores intervening debit')
+
+const missingAggregateResult = assignBalancesFromAllMovements(
+  [
+    {
+      legacyDate: '21.09.2026',
+      occurredAt: '2026-09-21T08:00:00.000Z',
+      amount: 100,
+      balance: null,
+      providerAliases: ['id:missing-aggregate-credit'],
+    },
+  ],
+  [
+    {
+      legacyDate: '21.09.2026',
+      createdAt: '2026-09-21T08:00:00.000Z',
+      changedAt: '2026-09-21T08:00:00.000Z',
+      amount: 100,
+      providerAliases: ['id:missing-aggregate-credit'],
+      direction: 'credit',
+    },
+  ],
+  new Map([
+    [
+      '21.09.2026',
+      { opening: null, debitTotal: null, creditTotal: 100, closing: 100 },
+    ],
+  ]),
+)
+assertEquals(
+  missingAggregateResult[0].balance,
+  null,
+  'missing aggregate fields do not become zero',
+)
+
+const totalsMismatch = assignBalancesFromAllMovements(
+  debitReceipts,
+  debitMovements,
+  new Map([
+    ['20.09.2026', { opening: 990, debitTotal: 60, creditTotal: 300, closing: 1230 }],
+  ]),
+)
+assertEquals(totalsMismatch[0].balance, null, 'daily aggregate mismatch suppresses whole day')
+assertEquals(totalsMismatch[1].balance, null, 'aggregate mismatch does not invent balance')
+
+const changedTie = assignBalancesFromAllMovements(
+  debitReceipts,
+  [
+    movement(debitReceipts[0], 'credit'),
+    {
+      legacyDate: '20.09.2026',
+      createdAt: '2026-09-20T08:00:00.000Z',
+      changedAt: debitReceipts[0].occurredAt,
+      amount: 50,
+      providerAliases: ['id:same-changed-second-debit'],
+      direction: 'debit',
+    },
+    movement(debitReceipts[1], 'credit'),
+  ],
+  debitSummaries,
+)
+assertEquals(changedTie[0].balance, null, 'same Changed timestamp does not invent order')
+
+const orderDisagreement = assignBalancesFromAllMovements(
+  debitReceipts,
+  [
+    movement(
+      debitReceipts[0],
+      'credit',
+      '2026-09-20T07:30:00.000Z',
+      '2026-09-20T09:00:00.000Z',
+    ),
+    {
+      legacyDate: '20.09.2026',
+      createdAt: '2026-09-20T08:00:00.000Z',
+      changedAt: '2026-09-20T08:00:00.000Z',
+      amount: 50,
+      providerAliases: ['id:order-disagreement-debit'],
+      direction: 'debit',
+    },
+    movement(debitReceipts[1], 'credit'),
+  ],
+  debitSummaries,
+)
+assertEquals(
+  orderDisagreement[0].balance,
+  null,
+  'Created and Changed order disagreement suppresses balances',
+)
+
+const invalidMovement = assignBalancesFromAllMovements(
+  debitReceipts,
+  [
+    movement(debitReceipts[0], 'credit'),
+    {
+      legacyDate: '20.09.2026',
+      createdAt: '',
+      changedAt: '2026-09-20T08:00:00.000Z',
+      amount: 50,
+      providerAliases: ['id:no-created-time-debit'],
+      direction: 'debit',
+    },
+    movement(debitReceipts[1], 'credit'),
+  ],
+  debitSummaries,
+)
+assertEquals(invalidMovement[0].balance, null, 'movement without both timestamps suppresses day')
+
+const updatedResult = copyKnownBalancesByProviderAlias(
+  [{ providerAliases: ['uetr:shared', 'id:earlier'], balance: null }],
+  productionResult,
+)
+assertEquals(updatedResult[0].balance, 7373.58, 'updated path reuses statement balance')
