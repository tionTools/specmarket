+Deno.test('Meest courier transfer is in transit, not recipient delivery, with OpenAPI', async () => {
+  const status = 'Відправлення видане кур’єру і прямує у підрозділ отримання'
+  await withCarrierResponse({ MEEST_API_TOKEN: 'test' }, { result: [{
+    eventDateTime: '2026-09-24 13:57:40', eventCode: '',
+    eventDescr: { descrUA: status },
+  }] }, async () => {
+    const result = await meestStatus('723-3447567')
+    assert(result.status === status, 'keep actual courier-transfer description')
+    assert(result.normalizedStatus === 'in_transit', 'courier transfer must not be delivered')
+    assert(result.final === false, 'courier transfer must remain active')
+    assert(result.details?.trackingDeliveredAt === '', 'courier transfer must not have a delivery timestamp')
+  })
+})
+
+Deno.test('Meest public courier transfer corrects a stale delivered status and clears delivery time', async () => {
+  const html = `<script>var salt = '0123456789abcdef0123456789abcdef';</script>`
+  const xml = `<return><result_table>
+<items><DateTimeAction>2026-09-21 12:07:43</DateTimeAction><StatusCode></StatusCode><ActionMessages>Відправлення готове до видачі</ActionMessages></items>
+<items><DateTimeAction>2026-09-24 13:57:40</DateTimeAction><StatusCode></StatusCode><ActionMessages>Відправлення видане кур’єру і прямує у підрозділ отримання</ActionMessages></items>
+</result_table></return>`
+  await withCarrierResponses({ MEEST_API_TOKEN: 'test' }, [
+    { body: { status: 'OK', result: [] } }, { body: html }, { body: xml },
+  ], async () => {
+    const result = await meestStatus('723-3447567')
+    assert(result.normalizedStatus === 'in_transit', 'newest public event must remain in transit')
+    assert(result.final === false, 'courier transfer must not be final')
+    assert(result.details?.trackingDeliveredAt === '', 'false delivery timestamp must be cleared')
+    const stale = {
+      ttn: '723-3447567', carrier: 'Meest', trackingStatus: 'Получено',
+      trackingNormalizedStatus: 'delivered', trackingDeliveredAt: '2026-09-23 11:45:00',
+    }
+    assert(trackingChanged(stale, result), 'forced per-order refresh must detect the correction')
+    const corrected = mergeTrackingDelivery(stale, result, '2026-09-24T14:00:00Z', 'manual')
+    assert(corrected.trackingNormalizedStatus === 'in_transit', 'merge must reopen tracking')
+    assert(corrected.trackingDeliveredAt === '', 'merge must remove previously incorrect delivery time')
+  })
+})
+
