+import { readFileSync, writeFileSync } from 'node:fs'
+
+function replaceExact(file, before, after, expected = 1) {
+  const source = readFileSync(file, 'utf8')
+  const occurrences = source.split(before).length - 1
+  if (occurrences !== expected) {
+    throw new Error(`${file}: expected ${expected} occurrence(s), found ${occurrences}`)
+  }
+  const next = expected === 1 ? source.replace(before, after) : source.split(before).join(after)
+  writeFileSync(file, next)
+}
+
+function removeExact(file, fragment, expected = 1) {
+  replaceExact(file, fragment, '', expected)
+}
