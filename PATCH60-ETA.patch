 ) {
   if (!isReturningDelivery(rawStatus, normalizedStatus, returnInProgress)) return ''
   const expected = formatTrackingExpectedDeliveryAt(expectedDeliveryAt)
-  return expected ? `Ожидается возврат: ${expected}` : ''
