diff --git a/tools/apply-patch44.mjs b/tools/apply-patch44.mjs
new file mode 100644
--- /dev/null
+++ b/tools/apply-patch44.mjs
@@ -0,0 +1,23 @@
+import { gunzipSync } from 'node:zlib'
+import { mkdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
+import { dirname } from 'node:path'
+
+const payload = JSON.parse(gunzipSync(Buffer.from("", 'base64')).toString('utf8'))
+
+for (const [path, content] of Object.entries(payload.files)) {
+  mkdirSync(dirname(path), { recursive: true })
+  writeFileSync(path, content, 'utf8')
+}
+
+for (const change of payload.replacements) {
+  const path = change.path
+  const source = readFileSync(path, 'utf8').replace(/\r\n/g, '\n')
+  const first = source.indexOf(change.old)
+  if (first < 0) throw new Error(`Patch 44: fragment not found (${change.label}) in ${path}`)
+  if (source.indexOf(change.old, first + change.old.length) >= 0) {
+    throw new Error(`Patch 44: fragment is not unique (${change.label}) in ${path}`)
+  }
+  writeFileSync(path, source.replace(change.old, change.new), 'utf8')
+}
+
+console.log('Patch 44 source transforms applied successfully.')
