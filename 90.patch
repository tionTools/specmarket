+Deno.test('Meest parses a single tracking event object instead of showing response OK', async () => {
+  await withCarrierResponse({ MEEST_API_TOKEN: 'test' }, {
+    status: 'OK',
+    result: {
+      eventDateTime: '2026-09-16 14:04:00',
+      eventCode: '2',
+      eventDescr: { descrUA: 'Відправлення створено, але не передано на доставку' },
+      eventCityDescr: { descrUA: 'Харків' },
+    },
+  }, async () => {
+    const result = await meestStatus('723-3447567')
+    assert(
+      result.status === 'Відправлення створено, але не передано на доставку',
+      'Meest single-event status must be shown instead of response OK',
+    )
+    assert(result.normalizedStatus === 'created', 'Meest event code 2 must remain created')
+    assert(
+      result.details?.trackingEventAt === '2026-09-16 14:04:00',
+      'Meest single-event timestamp must be preserved',
+    )
+  })
+})
+
+Deno.test('Meest does not expose generic OK when tracking events are still absent', async () => {
+  await withCarrierResponse({ MEEST_API_TOKEN: 'test' }, { status: 'OK', result: [] }, async () => {
+    const result = await meestStatus('M-CREATED')
+    assert(
+      result.status === 'Отправление создано, но не передано на доставку',
+      'Meest response OK must not be used as a shipment status',
+    )
+    assert(result.normalizedStatus === 'created', 'Meest OK fallback must remain created')
+    assert(result.final === false, 'Meest created shipment must remain non-final')
+  })
+})
+
